INVESTIX_DATABASE_URL=postgresql+psycopg://investix:investix@db:5432/investix
INVESTIX_SESSION_SECRET=replace-with-a-long-random-secret
INVESTIX_ADMIN_PASSWORD=replace-with-a-long-random-password
INVESTIX_DEV_AUTH_BYPASS=false
# Optional: required only when the Twelve Data EOD worker is enabled.
INVESTIX_TWELVE_DATA_API_KEY=
# Optional live quotes defaults (Twelve Data Free: max 8 credits/minute).
INVESTIX_LIVE_REFRESH_MINUTES=5
INVESTIX_LIVE_BATCH_SIZE=8
INVESTIX_LIVE_CREDITS_PER_MINUTE=8
INVESTIX_LIVE_DAILY_CREDITS=800
INVESTIX_LIVE_DAILY_RESERVE_PERCENT=20
INVESTIX_LIVE_SESSION_IDLE_MINUTES=10
POSTGRES_DB=investix
POSTGRES_USER=investix
POSTGRES_PASSWORD=replace-with-a-long-random-password
